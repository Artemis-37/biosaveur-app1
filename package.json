{
  "name": "biosaveur-molo-molo",
  "version": "1.0.0",
  "description": "BIOSAVEUR — Poulet Molo Molo : boutique en ligne, cotisation poulet, livraisons suivies par QR code et carte.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test test/*.test.js",
    "app:prepare": "node scripts/prepare-app.js",
    "app:sync": "node scripts/prepare-app.js && npx cap sync",
    "app:android": "node scripts/prepare-app.js && npx cap sync android && npx cap open android",
    "app:ios": "node scripts/prepare-app.js && npx cap sync ios && npx cap open ios",
    "app:apk": "node scripts/prepare-app.js && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/push-notifications": "^6.0.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/app": "6.0.2",
    "@capacitor/app-launcher": "6.0.3",
    "@capacitor/browser": "6.0.4",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/ios": "6.2.0",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2"
  }
}
