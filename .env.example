# Copier en .env (développement) ou saisir dans Render > Environment (production).

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://localhost:5432/biosaveur
# DATABASE_SSL=true          # nécessaire avec une URL de base de données externe
JWT_SECRET=remplacer-par-une-longue-chaine-aleatoire
# PUBLIC_URL=https://biosaveur-molomolo-gvbm.onrender.com   # rempli automatiquement sur Render

# Compte administrateur créé au démarrage s'il n'existe pas
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=changez-moi
ADMIN_NAME=Administrateur BIOSAVEUR

# Boutique
DELIVERY_FEE=1000
CHICKEN_PRICE=5000
REFERRAL_POINTS=500
DEPOT_NAME=Entrepôt BIOSAVEUR
DEPOT_LAT=5.3478
DEPOT_LNG=-4.0236

# CinetPay (laisser vide tant que le compte marchand n'est pas opérationnel)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
# Guichet de test sans argent réel (activé par défaut hors production)
# CINETPAY_SIMULATE=true

# Cartes (par défaut : fonds OpenStreetMap ; pour un fort trafic, prenez un fournisseur avec clé : MapTiler, Stadia, Geoapify…)
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Données de démonstration (comptes et commandes d'exemple). Ne pas activer en production.
# SEED_DEMO=true

# Notifications push navigateur (facultatif : générées automatiquement et conservées en base si absentes)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@biosaveur.ci
